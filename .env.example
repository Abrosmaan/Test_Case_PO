# All optional. The app works fully without them.
API_PORT=3000
LOG_LEVEL=info
CHECK_DATE=2026-03-10

# Optional LLM fallback for documents the rules could not recognise.
# auto = Gemini if LLM_API_KEY is set, otherwise off. Also: gemini | ollama | none
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
OLLAMA_URL=http://127.0.0.1:11434
